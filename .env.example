# Copy to .env and fill in. Never commit .env.
# SECRET_KEY, VAULT_KEY and ADMIN_PASSWORD left empty are generated by the hub on first start and
# kept beside the database, so the example is safe to copy unchanged. run.sh also writes fresh keys
# when it creates .env. Under docker compose they are kept in the data volume, and the compose file
# sets DATABASE_URL, UPLOAD_DIR and OLLAMA_BASE_URL itself, whatever this file says.

# --- security -----------------------------------------------------------------------------
# Signs session cookies. Rotating it signs everyone out. Empty: generated into session.key.
SECRET_KEY=
# Encrypts the vault, the message history and uploaded text. Back it up: without it the history
# is unreadable and no answer can be de-anonymized again.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# Set to true for any deployment behind HTTPS: marks cookies Secure and sends HSTS.
COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=14
# Failed sign-ins tolerated per account before it locks for the window below.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- cloud provider (OpenAI-compatible) ---------------------------------------------------
# OpenRouter gives access to Claude and others through one key. Left empty, no key is sent, for
# an endpoint that needs none, such as Ollama's /v1.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Any model the provider lists; anthropic/claude-sonnet-5.5 costs half as much.
LLM_MODEL=anthropic/claude-opus-5.5

# --- stage 2 judge ------------------------------------------------------------------------
# mock   = a fixed list of phrases, for demos and tests
# ollama = a small model on this machine; masked text never leaves the network
# remote = the cloud provider above; masked text leaves the network, testing only
JUDGE_BACKEND=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen2.5:1.5b
JUDGE_TIMEOUT_SECONDS=20

# --- first admin account, created on first startup if no users exist -----------------------
ADMIN_USERNAME=admin
# Empty: a password is generated and written to initial-admin-password beside the database.
ADMIN_PASSWORD=

# --- storage and retention ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/polgate.db
UPLOAD_DIR=data/uploads
# A message queued for streaming whose browser never connected is dropped after this long.
PENDING_TURN_TTL_MINUTES=60

# --- context budget -----------------------------------------------------------------------
# Earlier turns replayed to the provider on each message. Older ones are dropped rather than
# growing the request until the model refuses it.
HISTORY_BUDGET_CHARS=24000
# Attached document text sent per file, per turn. Attachments ride along with every message, so a
# long PDF would otherwise be paid for again each time.
ATTACHMENT_BUDGET_CHARS=60000

# --- search in attachments (RAG) ----------------------------------------------------------
# A file over the budget above sends the passages that match the question instead of its first
# characters. Off while EMBEDDING_MODEL is empty: no text goes to an embeddings endpoint until you
# choose one. A local endpoint is the recommended choice, since the masked document then stays on
# this machine: LM Studio (http://localhost:1234/v1) or Ollama (http://localhost:11434/v1) with
# a multilingual model such as bge-m3.
EMBEDDING_MODEL=
# Empty: the chat provider's LLM_BASE_URL, with its key. Set: only EMBEDDING_API_KEY is sent there.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_CHUNK_CHARS=1200
# Passages indexed per file; the rest of a longer file is not searched, and the chat says so.
RETRIEVAL_MAX_CHUNKS_PER_FILE=500

# --- language and models ------------------------------------------------------------------
SPACY_MODEL=pl_core_news_md
DEFAULT_LANGUAGE=pl
